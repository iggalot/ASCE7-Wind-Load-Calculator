<UserControl x:Class="ASCE7WindLoadCalculator.Wind3DViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="960"
             Background="#FCFCFB" FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <SolidColorBrush x:Key="InkPrimary" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="InkSecondary" Color="#52514E"/>
        <SolidColorBrush x:Key="InkMuted" Color="#898781"/>
        <SolidColorBrush x:Key="Hairline" Color="#E1E0D9"/>
        <SolidColorBrush x:Key="Card" Color="#F2FCFCFB"/>

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Hairline}"
                                Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0B0B0B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0B0B0B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Hairline}"
                                Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The flyout tab on the view's right edge (as the Shear Wall Calculator's PLAN / DATA tabs): VIEW opens or closes the
             panel with what the view shows, so the model can take the whole width -->
        <Style x:Key="EdgeTab" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="2,8,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A4945"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#F1F0EA" BorderBrush="#D8D6CC" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.LayoutTransform><RotateTransform Angle="-90"/></ContentPresenter.LayoutTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E4E9F5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 3D area with overlays -->
        <Grid x:Name="viewHost" Background="#FCFCFB" ClipToBounds="True"
              MouseDown="View_MouseDown"
              MouseMove="View_MouseMove" MouseUp="View_MouseUp" MouseWheel="View_MouseWheel" MouseLeave="View_MouseLeave">

            <Viewport3D x:Name="viewport">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="camera" FieldOfView="40" NearPlaneDistance="0.5" FarPlaneDistance="100000"/>
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup x:Name="sceneRoot"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
            </Viewport3D>

            <!-- Labels pinned to 3D points (north arrow, wind arrow), positioned by projecting through the camera -->
            <Canvas x:Name="labelLayer" IsHitTestVisible="False">
                <TextBlock x:Name="lblNorth" Text="N" FontWeight="SemiBold" FontSize="14" Foreground="#52514E"/>
                <TextBlock x:Name="lblWind" Text="Wind" FontWeight="SemiBold" FontSize="14" Foreground="#52514E"/>
            </Canvas>
            <!-- Wall markers (windward, leeward, side) and floor labels, pinned the same way -->
            <Canvas x:Name="markerLayer" IsHitTestVisible="False"/>

            <!-- Title -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8,0,0" IsHitTestVisible="False">
                <TextBlock x:Name="tbTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkPrimary}" Text="Wind pressures"/>
                <TextBlock x:Name="tbSubtitle" Foreground="{StaticResource InkSecondary}" Text="Enter building and wind inputs to see results"/>
            </StackPanel>

            <!-- Warnings -->
            <Border x:Name="bdWarnings" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,52,0,0"
                    MaxWidth="460" Background="#FFF4E5" BorderBrush="#E8A33D" BorderThickness="1" CornerRadius="4" Padding="10,6"
                    IsHitTestVisible="False">
                <TextBlock x:Name="tbWarnings" TextWrapping="Wrap" Foreground="#7A4B00"/>
            </Border>

            <!-- Legend: a slim bar, no card, so it hides as little of the model as possible -->
            <Border x:Name="bdLegend" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" Padding="6,4"
                    Background="#CCFCFCFB" CornerRadius="4" IsHitTestVisible="False"
                    ToolTip="Net pressure in psf. Blue pushes on the surface; red pulls away (suction).">
                <StackPanel>
                    <TextBlock Text="psf" FontWeight="SemiBold" Foreground="{StaticResource InkPrimary}" HorizontalAlignment="Center" FontSize="11"/>
                    <TextBlock Text="push" Foreground="{StaticResource InkSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="9"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="legendBar" Grid.Column="0" Height="120" CornerRadius="2"/>
                        <Canvas x:Name="legendTicks" Grid.Column="1" Width="30" Height="120" Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Text="pull" Foreground="{StaticResource InkSecondary}" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Summary -->
            <Border x:Name="bdSummary" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,44" Padding="12,10"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="6"
                    IsHitTestVisible="False" MaxWidth="420">
                <StackPanel x:Name="spSummary"/>
            </Border>

            <!-- Camera presets and display toggles, inside the view so the toolbar stays one row -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" Orientation="Horizontal">
                <Button Style="{StaticResource ViewButton}" Content="3D" Click="ViewIso_Click" ToolTip="Angled view (double-click the model also resets)"/>
                <Button Style="{StaticResource ViewButton}" Content="Top" Click="ViewTop_Click"/>
                <Button Style="{StaticResource ViewButton}" Content="S" Click="ViewSouth_Click" ToolTip="Look at the south wall"/>
                <Button Style="{StaticResource ViewButton}" Content="W" Click="ViewWest_Click" ToolTip="Look at the west wall" Margin="0,0,12,0"/>
                <CheckBox x:Name="cbBlocks" Content="Blocks" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"
                          Foreground="{StaticResource InkSecondary}" Checked="Display_Changed" Unchecked="Display_Changed"
                          ToolTip="Draw each zone's pressure as a block standing on the surface; taller = stronger"/>
                <CheckBox x:Name="cbOutlines" Content="Outlines" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"
                          Foreground="{StaticResource InkSecondary}" Checked="Outlines_Changed" Unchecked="Outlines_Changed"
                          ToolTip="Show zone boundaries"/>
                <CheckBox x:Name="cbPsfLabels" Content="psf labels" IsChecked="False" VerticalAlignment="Center"
                          Foreground="{StaticResource InkSecondary}" Checked="PsfLabels_Changed" Unchecked="PsfLabels_Changed"
                          ToolTip="Write each zone's net pressure (psf, + toward the surface, − suction) on the zone. A label is left out when the zone is too small to hold it at this zoom, or hidden behind the building."/>
            </StackPanel>

            <!-- Controls hint -->
            <TextBlock x:Name="tbControlsHint" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" FontSize="11"
                       Foreground="{StaticResource InkMuted}" IsHitTestVisible="False"
                       Text="Drag: rotate · Right-drag: pan · Wheel: zoom"/>

            <!-- Hover card -->
            <Border x:Name="bdHover" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="White" BorderBrush="#C3C2B7" BorderThickness="1" CornerRadius="4" Padding="10,7"
                    IsHitTestVisible="False" MaxWidth="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="tbHoverValue" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkPrimary}"/>
                    <TextBlock x:Name="tbHoverWhat" Foreground="{StaticResource InkPrimary}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="tbHoverWhere" Foreground="{StaticResource InkSecondary}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Button x:Name="btnEdgeView" Grid.Column="1" Style="{StaticResource EdgeTab}" Click="EdgeView_Click" Content="▼  VIEW"
                ToolTip="Close the view panel: the model takes the whole width"/>

        <!-- VIEW: what the model shows (cladding, the two whole-building directions, or the wind cases); the wind cases
             grouped by where the wind comes from, each group opened to its cases. Select one to draw it; the arrow keys step
             through the list. -->
        <Border x:Name="bdView" Grid.Column="2" Width="290" BorderBrush="{StaticResource Hairline}" BorderThickness="1,0,0,0" Padding="8,6">
            <DockPanel>
                <StackPanel x:Name="bdModes" DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource PanelLabel}" Text="CLADDING"
                               ToolTip="Components and cladding: roofing, siding, windows (Chapter 30)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="rbCladSuction" GroupName="mode" Style="{StaticResource Segment}"
                                     Content="Suction" Checked="Mode_Checked"
                                     ToolTip="Wind trying to pull roofing and siding away (suction / uplift). Worst case from any wind direction. Used to fasten coverings."/>
                        <RadioButton x:Name="rbCladPressure" GroupName="mode" Style="{StaticResource Segment}" Margin="0"
                                     Content="Push-in" Checked="Mode_Checked"
                                     ToolTip="Wind pushing roofing and siding inward. Worst case from any wind direction."/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PanelLabel}" Text="SHEAR WALLS"
                               ToolTip="Whole building (main wind force resisting system, Chapter 27): these pressures load the shear walls"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="rbWindWest" GroupName="mode" Style="{StaticResource Segment}" IsChecked="True"
                                     Content="From W" Checked="Mode_Checked"
                                     ToolTip="Whole-building pressures with wind blowing from the west (along the building length)."/>
                        <RadioButton x:Name="rbWindSouth" GroupName="mode" Style="{StaticResource Segment}"
                                     Content="From S" Checked="Mode_Checked"
                                     ToolTip="Whole-building pressures with wind blowing from the south (along the building width)."/>
                        <RadioButton x:Name="rbCases" GroupName="mode" Style="{StaticResource Segment}" Margin="0"
                                     Content="Wind cases" Checked="Mode_Checked"
                                     ToolTip="Every Fig. 27.3-8 wind case, one at a time: each wind (W, E, S, N and the quartering winds), each roof value, each sign of GCpi and each torsion, with its own wall and roof zones. The envelope shows the largest pressure or the largest suction of all the cases, each with the case that gives it."/>
                    </StackPanel>
                    <StackPanel x:Name="spRoofCase" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Roof Cp" Foreground="{StaticResource InkSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton x:Name="rbCaseA" GroupName="roof" Style="{StaticResource Segment}" IsChecked="True" Content="Case A" Checked="Mode_Checked"
                                     ToolTip="Fig. 27.3-1 gives two roof Cp values for many zones. Case A is the first value listed (on a flat roof: -0.9 / -0.5 / -0.3 by distance from the windward edge). Both values are cases of their own."/>
                        <RadioButton x:Name="rbCaseB" GroupName="roof" Style="{StaticResource Segment}" Margin="0" Content="Case B" Checked="Mode_Checked"
                                     ToolTip="Case B is the second Fig. 27.3-1 roof value (on a flat roof: -0.18 over the whole roof). Both values are cases of their own."/>
                    </StackPanel>
                </StackPanel>

                <DockPanel x:Name="bdCases" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Procedure" Foreground="{StaticResource InkSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton x:Name="rbProc27" GroupName="proc" Style="{StaticResource Segment}" IsChecked="True" Content="Ch. 27" Checked="Procedure_Checked"
                                     ToolTip="Directional procedure: Fig. 27.3-8 Cases 1 to 4, quartering winds resolved area by area."/>
                        <RadioButton x:Name="rbProc28" GroupName="proc" Style="{StaticResource Segment}" Margin="0" Content="Ch. 28" Checked="Procedure_Checked"
                                     ToolTip="Envelope procedure (low-rise): Figs. 28.3-1 and 28.3-2, Load Cases 1 to 4 with each building corner as the reference corner. The two procedures are alternatives: each has its own envelope."/>
                    </StackPanel>
                    <TextBox x:Name="tbCaseFilter" DockPanel.Dock="Top" Margin="0,0,0,6" TextChanged="CaseFilter_Changed"
                             ToolTip="Show only the cases whose name holds this text (e.g. &quot;Case 3&quot;, &quot;torsion&quot;, &quot;−GCpi&quot;); the groups with a match open"/>
                    <TextBlock x:Name="tbCaseCount" DockPanel.Dock="Top" Foreground="{StaticResource InkMuted}" FontSize="11" Margin="0,0,0,4"/>
                    <TreeView x:Name="tvCases" SelectedItemChanged="Cases_SelectionChanged" BorderBrush="{StaticResource Hairline}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
