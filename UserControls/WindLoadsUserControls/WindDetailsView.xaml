<UserControl x:Class="ASCE7WindLoadCalculator.WindDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F9F9F7" FontFamily="Segoe UI" FontSize="13" Foreground="#0B0B0B">

    <UserControl.Resources>
        <!-- Left navigation entry -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0EFEC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0B0B0B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="#FCFCFB" BorderBrush="#E1E0D9" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Detailed wind calculations"/>
                <TextBlock x:Name="tbInputs" Foreground="#52514E" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#FCFCFB" BorderBrush="#E1E0D9" BorderThickness="0,0,1,0" Padding="12">
            <StackPanel x:Name="spNav"/>
        </Border>

        <ScrollViewer x:Name="svPage" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ContentControl x:Name="ccPage" Margin="20,16"/>
        </ScrollViewer>
    </Grid>
</UserControl>
