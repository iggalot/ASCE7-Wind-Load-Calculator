<UserControl x:Class="ASCE7WindLoadCalculator.WindSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ASCE7WindLoadCalculator"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1360"
             Background="#E6E9EE" FontFamily="Segoe UI" FontSize="13" Foreground="#0B0B0B">

    <UserControl.Resources>
        <SolidColorBrush x:Key="InkPrimary" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="InkSecondary" Color="#52514E"/>
        <SolidColorBrush x:Key="Hairline" Color="#D5DAE1"/>
        <SolidColorBrush x:Key="Control" Color="#C3C2B7"/>
        <SolidColorBrush x:Key="Surface" Color="#F3F5F8"/>
        <SolidColorBrush x:Key="Selected" Color="#F0EFEC"/>
        <SolidColorBrush x:Key="WarnInk" Color="#8A3B00"/>
        <SolidColorBrush x:Key="WarnBorder" Color="#B45309"/>
        <SolidColorBrush x:Key="OkInk" Color="#006300"/>

        <!-- A group of related inputs -->
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8,14,10"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Site page: one row per step, label on the left -->
        <GridLength x:Key="StepLabelWidth">180</GridLength>
        <Style x:Key="SiteRow" TargetType="Border" BasedOn="{StaticResource Section}">
            <Setter Property="Padding" Value="14,8,14,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
        </Style>
        <Style x:Key="StepName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="StepHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="FieldMessage" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{StaticResource WarnInk}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Large selectable card (radio button): a title line plus a description -->
        <Style x:Key="Card" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Control}"
                                Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0B0B0B"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="#E4EDFA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2A78D6"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact choice (radio button) -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Control}"
                                Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0B0B0B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0B0B0B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2A78D6"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Number box: the TextBox sits inside a Border that also shows the unit -->
        <Style x:Key="NumberFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Footer buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="#0B0B0B" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33332F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#898781"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="White" BorderBrush="{StaticResource Control}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Step indicator button -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <!-- Stat cards share one grid (label / number + unit / two detail lines) so the numbers line up -->
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="StatUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
            <Setter Property="Margin" Value="5,0,0,4"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="StatDetail" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
    </UserControl.Resources>

    <!-- Laid out to fit the Wind Setup tab beside the drawing canvas (about 1130 x 790 at 1920 x 1080)
         without scrolling. Scroll bars appear only if the window is made smaller than that. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header with the step indicator ===== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="20,4">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="tbStepTitle" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="Where is the building?"/>
                <StackPanel x:Name="spSteps" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,12,20,12">

            <!-- ========== PAGE 1: SITE — one labelled row per step, in the order they are decided ========== -->
            <ScrollViewer x:Name="pnlSite" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Step 1: code edition (decides the maps, figures and equations used everywhere else) -->
                    <Border Style="{StaticResource SiteRow}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource StepLabelWidth}"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StepNumber}" Text="STEP 1"/>
                                <TextBlock Style="{StaticResource StepName}" Text="ASCE 7 EDITION"/>
                                <TextBlock Style="{StaticResource StepHint}" Text="The one your building department enforces."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="rbEd22" GroupName="ed" Style="{StaticResource Chip}" Content="ASCE 7-22" Checked="Input_Changed"/>
                                <RadioButton x:Name="rbEd16" GroupName="ed" Style="{StaticResource Chip}" Margin="0" Content="ASCE 7-16" Checked="Input_Changed"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Text="ASCE 7-22 is referenced by the 2024 IBC; ASCE 7-16 by the 2018 and 2021 IBC. If unsure, ask the building department."/>
                        </Grid>
                    </Border>

                    <!-- Step 2: risk category (before the wind speed: it picks the wind-speed map) -->
                    <Border Style="{StaticResource SiteRow}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource StepLabelWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StepNumber}" Text="STEP 2"/>
                                <TextBlock Style="{StaticResource StepName}" Text="RISK CATEGORY"/>
                                <TextBlock Style="{StaticResource StepHint}" Text="How important the building is. Picks the wind-speed map; it does not multiply the loads."/>
                            </StackPanel>
                            <UniformGrid Grid.Column="1" Columns="4">
                                <RadioButton x:Name="rbRisk1" GroupName="risk" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="I: Low hazard"/><TextBlock Style="{StaticResource Hint}" Text="Barns, sheds, minor storage"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbRisk2" GroupName="risk" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="II: Most buildings"/><TextBlock Style="{StaticResource Hint}" Text="Homes, offices, shops"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbRisk3" GroupName="risk" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="III: Many people"/><TextBlock Style="{StaticResource Hint}" Text="Schools, large venues"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbRisk4" GroupName="risk" Style="{StaticResource Card}" Margin="0" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="IV: Essential"/><TextBlock Style="{StaticResource Hint}" Text="Hospitals, fire and police stations"/></StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Step 3: wind speed, the most important site input, so it is highlighted -->
                    <Border Style="{StaticResource SiteRow}" Background="#EEF4FC" BorderBrush="#2A78D6" BorderThickness="2">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource StepLabelWidth}"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StepNumber}" Foreground="#104281" Text="STEP 3"/>
                                <TextBlock Style="{StaticResource StepName}" Foreground="#104281" Text="WIND SPEED"/>
                                <TextBlock Style="{StaticResource StepHint}" Text="Basic wind speed V from the ASCE 7 map."/>
                            </StackPanel>
                            <Border x:Name="bdV" Grid.Column="1" Style="{StaticResource NumberFrame}" BorderThickness="2" BorderBrush="#2A78D6" Height="42" Width="160" VerticalAlignment="Center">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Unit}" Margin="0,0,8,0" Text="V ="/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="mph"/>
                                    <TextBox x:Name="tbV" Style="{StaticResource NumberBox}" MinWidth="40" FontSize="20" FontWeight="SemiBold" TextChanged="Input_Changed"
                                             AutomationProperties.Name="Wind speed V in mph"/>
                                </DockPanel>
                            </Border>
                            <StackPanel Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap">Read the map for <Run x:Name="runRisk" FontWeight="SemiBold" Foreground="#104281" Text="Risk Category II"/> (Step 2).</TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0">Look it up by address: <Hyperlink NavigateUri="https://ascehazardtool.org" RequestNavigate="Hyperlink_RequestNavigate">ASCE Hazard Tool</Hyperlink> (free).</TextBlock>
                            </StackPanel>
                            <TextBlock x:Name="msgV" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldMessage}"/>
                        </Grid>
                    </Border>

                    <!-- Step 4: exposure -->
                    <Border Style="{StaticResource SiteRow}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource StepLabelWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StepNumber}" Text="STEP 4"/>
                                <TextBlock Style="{StaticResource StepName}" Text="EXPOSURE"/>
                                <TextBlock Style="{StaticResource StepHint}" Text="What the ground is like upwind of the site."/>
                            </StackPanel>
                            <UniformGrid Grid.Column="1" Columns="3">
                                <RadioButton x:Name="rbExpB" GroupName="exp" Style="{StaticResource Card}" VerticalContentAlignment="Top" Checked="Input_Changed">
                                    <StackPanel>
                                        <DockPanel>
                                            <Canvas DockPanel.Dock="Left" Width="60" Height="28" Margin="0,0,10,0">
                                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Canvas.RenderTransform>
                                                <Path Stroke="#898781" StrokeThickness="1.5" Data="M2,38 H82"/>
                                                <Path Stroke="#52514E" StrokeThickness="1.5" Data="M6,18 h12 v20 h-12 z M22,10 h10 v28 h-10 z M38,38 V24 l7,-6 7,6 v14 M70,38 V22 l6,-5 6,5 v16"/>
                                                <Ellipse Canvas.Left="55" Canvas.Top="17" Width="14" Height="14" Stroke="#52514E" StrokeThickness="1.5"/>
                                                <Path Stroke="#52514E" StrokeThickness="1.5" Data="M62,31 V38"/>
                                            </Canvas>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="B: Suburbs, towns, woods"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Houses or trees close together for at least 2,600 ft upwind (1,500 ft if the mean roof height is 30 ft or less), or 20 × the building height if more."/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbExpC" GroupName="exp" Style="{StaticResource Card}" VerticalContentAlignment="Top" Checked="Input_Changed">
                                    <StackPanel>
                                        <DockPanel>
                                            <Canvas DockPanel.Dock="Left" Width="60" Height="28" Margin="0,0,10,0">
                                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Canvas.RenderTransform>
                                                <Path Stroke="#898781" StrokeThickness="1.5" Data="M2,38 H82"/>
                                                <Path Stroke="#52514E" StrokeThickness="1.5" Data="M12,38 V28 l6,-5 6,5 v10 M52,34 v4"/>
                                                <Ellipse Canvas.Left="47" Canvas.Top="24" Width="10" Height="10" Stroke="#52514E" StrokeThickness="1.5"/>
                                            </Canvas>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="C: Open country, farmland"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Scattered buildings or trees. Anywhere B or D does not apply; the usual choice when in doubt."/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbExpD" GroupName="exp" Style="{StaticResource Card}" Margin="0" VerticalContentAlignment="Top" Checked="Input_Changed">
                                    <StackPanel>
                                        <DockPanel>
                                            <Canvas DockPanel.Dock="Left" Width="60" Height="28" Margin="0,0,10,0">
                                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Canvas.RenderTransform>
                                                <Path Stroke="#52514E" StrokeThickness="1.5" Data="M2,30 c8,-4 14,4 22,0 s14,-4 22,0 14,4 22,0 10,-3 14,-1"/>
                                                <Path Stroke="#898781" StrokeThickness="1.5" Data="M2,38 H82"/>
                                            </Canvas>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="D: Shoreline, open water"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="Only if water or flat open land runs at least 5,000 ft upwind, or 20 × the building height if more. Also within 600 ft (or 20 × height) downwind of it."/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Step 5: building type (enclosure) -->
                    <Border Style="{StaticResource SiteRow}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource StepLabelWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StepNumber}" Text="STEP 5"/>
                                <TextBlock Style="{StaticResource StepName}" Text="BUILDING TYPE"/>
                                <TextBlock Style="{StaticResource StepHint}" Text="How open the walls are (enclosure, Section 26.12)."/>
                            </StackPanel>
                            <UniformGrid Grid.Column="1" Columns="4">
                                <RadioButton x:Name="rbEncEnclosed" GroupName="enc" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Enclosed"/><TextBlock Style="{StaticResource Hint}" Text="Normal walls, doors and windows (most buildings)"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbEncPartEnc" GroupName="enc" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Partially enclosed"/><TextBlock Style="{StaticResource Hint}" Text="One wall much more open, e.g. a large door often left open"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbEncPartOpen" GroupName="enc" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Partially open"/><TextBlock Style="{StaticResource Hint}" Text="None of the other three"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbEncOpen" GroupName="enc" Style="{StaticResource Card}" Margin="0" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Open"/><TextBlock Style="{StaticResource Hint}" Text="Every wall at least 80% open, e.g. a carport"/></StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Step 6: terrain (hills) -->
                    <Border Style="{StaticResource SiteRow}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource StepLabelWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StepNumber}" Text="STEP 6"/>
                                <TextBlock Style="{StaticResource StepName}" Text="TERRAIN"/>
                                <TextBlock Style="{StaticResource StepHint}" Text="Hills speed up the wind (Kzt, Section 26.8)."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbHillNo" GroupName="hill" Style="{StaticResource Chip}" Content="Fairly flat ground" Checked="Input_Changed"/>
                                    <RadioButton x:Name="rbHillYes" GroupName="hill" Style="{StaticResource Chip}" Content="On a hill, ridge or bluff" Checked="Input_Changed"/>
                                    <!-- Kzt is always shown: fixed at 1.00 for flat ground, editable for a hill -->
                                    <TextBlock x:Name="tbKztFixed" VerticalAlignment="Center" Margin="8,0,0,0">Kzt = <Run FontWeight="SemiBold" Text="1.00"/></TextBlock>
                                    <StackPanel x:Name="pnlKzt" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,0">
                                        <Border x:Name="bdKzt" Style="{StaticResource NumberFrame}" Width="110" BorderBrush="#2A78D6" BorderThickness="2">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Unit}" Margin="0,0,6,0" Text="Kzt ="/>
                                                <TextBox x:Name="tbKzt" Style="{StaticResource NumberBox}" MinWidth="40" TextChanged="Input_Changed" AutomationProperties.Name="Topographic factor Kzt"/>
                                            </DockPanel>
                                        </Border>
                                        <TextBlock x:Name="tbKztHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="330"
                                                   Text="Enter Kzt from Section 26.8 (Fig. 26.8-1). It is 1.0 or more."/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="msgKzt" Style="{StaticResource FieldMessage}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== STEP 2: BUILDING — inputs left, 3D view right ========== -->
            <Grid x:Name="pnlBuilding" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="svBuildingInputs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Section}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Roof shape"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbRoofFlat" GroupName="roof" Style="{StaticResource Chip}" Checked="Input_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="30" Height="18" Margin="0,0,8,0"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Data="M3,7 h24 v10 h-24 z M2,7 h26"/></Canvas>
                                            <TextBlock Text="Flat" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbRoofGable" GroupName="roof" Style="{StaticResource Chip}" Checked="Input_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="30" Height="18" Margin="0,0,8,0"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M4,9 h22 v8 h-22 z M2,10 L15,1 28,10"/></Canvas>
                                            <TextBlock Text="Gable" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbRoofHip" GroupName="roof" Style="{StaticResource Chip}" Margin="0" Checked="Input_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="30" Height="18" Margin="0,0,8,0"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M4,9 h22 v8 h-22 z M2,10 L9,2 21,2 28,10"/></Canvas>
                                            <TextBlock Text="Hip" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Size (to the outside of the walls)"/>
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Length L (W-E)"/>
                                        <Border x:Name="bdL" Style="{StaticResource NumberFrame}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                                <TextBox x:Name="tbL" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Length L in feet"/></DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Width B (S-N)"/>
                                        <Border x:Name="bdB" Style="{StaticResource NumberFrame}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                                <TextBox x:Name="tbB" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Width B in feet"/></DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Eave height"/>
                                        <Border x:Name="bdH" Style="{StaticResource NumberFrame}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                                <TextBox x:Name="tbH" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Wall height to eave in feet"/></DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel ToolTip="Roof overhang beyond the wall face. Overhang pressures (27.3.3 and the Chapter 30 overhang zones) are listed in Detailed calculations; 0 for none.">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Eave overhang"/>
                                        <Border x:Name="bdOverhang" Style="{StaticResource NumberFrame}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                                <TextBox x:Name="tbOverhang" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Roof overhang in feet"/></DockPanel>
                                        </Border>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            ToolTip="Stories (floors) for the shear-wall design, 1 to 3. The eave height is split equally; each floor diaphragm and the roof take the wind on their own strip of the walls, and the shear walls are designed from the top story down.">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Floors" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="cbStories" Width="60" Height="30" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="Input_Changed"
                                              AutomationProperties.Name="Number of stories">
                                        <ComboBoxItem Content="1"/>
                                        <ComboBoxItem Content="2"/>
                                        <ComboBoxItem Content="3"/>
                                    </ComboBox>
                                    <TextBlock x:Name="tbStoryHeight" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#52514E"/>
                                </StackPanel>
                                <TextBlock x:Name="msgSize" Style="{StaticResource FieldMessage}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="secSlope" Style="{StaticResource Section}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Roof slope"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="bdPitch" Style="{StaticResource NumberFrame}" Width="120">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="deg"/>
                                            <TextBox x:Name="tbPitch" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" LostFocus="Pitch_LostFocus" AutomationProperties.Name="Roof pitch in degrees"/></DockPanel>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource InkSecondary}">
                                        = <Run x:Name="runRise" FontWeight="SemiBold" Foreground="#0B0B0B" Text="-"/> (rise per 12 in. of run)</TextBlock>
                                </StackPanel>
                                <StackPanel x:Name="pnlRidge" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="The ridge runs"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rbRidgeAlong" GroupName="ridge" Style="{StaticResource Chip}" Content="Along the length (W-E)" Checked="Input_Changed"/>
                                        <RadioButton x:Name="rbRidgeAcross" GroupName="ridge" Style="{StaticResource Chip}" Margin="0" Content="Across the width (S-N)" Checked="Input_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="tbHipNote" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="A hip roof's ridge runs along the longer side."/>
                                <TextBlock x:Name="msgPitch" Style="{StaticResource FieldMessage}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="secParapet" Style="{StaticResource Section}" Margin="0,0,0,8"
                                ToolTip="Parapets add horizontal force to the shear walls (27.3.4): pp = qp Kd (GCpn), +1.5 windward and -1.0 leeward, qp at the top of the parapet.">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Parapet"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="bdParapet" Style="{StaticResource NumberFrame}" Width="120">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                            <TextBox x:Name="tbParapet" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Parapet height above the roof in feet"/></DockPanel>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource InkSecondary}" Text="above the roof, all around"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Envelope (cladding GCpi)"/>
                                    <ComboBox x:Name="cbParapetEnvelope" Width="190" Height="30" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="Input_Changed"
                                              AutomationProperties.Name="Parapet envelope porosity for its internal pressure"
                                              ToolTip="Cladding only (30.6): GCpi from Table 26.13-1 for the porosity of the parapet envelope itself, not the building. A parapet sheathed on both faces is usually enclosed; a solid or open parapet has no internal pressure.">
                                        <ComboBoxItem Content="Enclosed (GCpi ±0.18)"/>
                                        <ComboBoxItem Content="Partially enclosed (±0.55)"/>
                                        <ComboBoxItem Content="Partially open (±0.18)"/>
                                        <ComboBoxItem Content="Open or solid (0)"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock x:Name="msgParapet" Style="{StaticResource FieldMessage}"/>
                            </StackPanel>
                        </Border>

                        <!-- Cladding component: C&C GCp is read at its effective wind area (26.2) in every zone -->
                        <Border x:Name="secComponent" Style="{StaticResource Section}" Margin="0,0,0,8"
                                ToolTip="Effective wind area (26.2): span × span/3 for framing. Smaller areas give higher pressures; 10 sq ft covers sheathing and fasteners.">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4">Cladding component <Run Foreground="#52514E" FontWeight="Normal">(sets the effective wind area)</Run></TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Roof" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cbRoofComponent" Grid.Column="1" Height="30" VerticalContentAlignment="Center" SelectionChanged="Component_Changed"
                                              AutomationProperties.Name="Roof component">
                                        <ComboBoxItem Content="Sheathing, roofing fasteners"/>
                                        <ComboBoxItem Content="Rafters or trusses (enter span)"/>
                                        <ComboBoxItem Content="Other (enter its area)"/>
                                    </ComboBox>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Border x:Name="bdRoofComp" Style="{StaticResource NumberFrame}" Height="30" Width="72" Padding="6,0">
                                            <DockPanel><TextBlock x:Name="tbRoofCompUnit" DockPanel.Dock="Right" Style="{StaticResource Unit}" Margin="4,0,0,0" Text="ft"/>
                                                <TextBox x:Name="tbRoofComp" Style="{StaticResource NumberBox}" FontSize="13" MinWidth="20" TextChanged="Input_Changed" AutomationProperties.Name="Roof component span or area"/></DockPanel>
                                        </Border>
                                        <TextBlock x:Name="tbRoofCompArea" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="70" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Walls" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <ComboBox x:Name="cbWallComponent" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,6,0,0" VerticalContentAlignment="Center" SelectionChanged="Component_Changed"
                                              AutomationProperties.Name="Wall component">
                                        <ComboBoxItem Content="Sheathing, siding, fasteners"/>
                                        <ComboBoxItem Content="Studs (enter stud height)"/>
                                        <ComboBoxItem Content="Window, door or other (enter area)"/>
                                    </ComboBox>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,6,0,0">
                                        <Border x:Name="bdWallComp" Style="{StaticResource NumberFrame}" Height="30" Width="72" Padding="6,0">
                                            <DockPanel><TextBlock x:Name="tbWallCompUnit" DockPanel.Dock="Right" Style="{StaticResource Unit}" Margin="4,0,0,0" Text="ft"/>
                                                <TextBox x:Name="tbWallComp" Style="{StaticResource NumberBox}" FontSize="13" MinWidth="20" TextChanged="Input_Changed" AutomationProperties.Name="Wall component height or area"/></DockPanel>
                                        </Border>
                                        <TextBlock x:Name="tbWallCompArea" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="70" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Derived from the inputs as they are typed: the values the zone layout and Fig. 27.3-1 read -->
                        <UniformGrid x:Name="ugBuildingNumbers" Columns="3" Rows="2">
                            <Border Style="{StaticResource StatCard}" Padding="10,4" Margin="0,0,8,8">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" FontSize="11" Text="Mean roof height h"/><TextBlock x:Name="valMeanH" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Padding="10,4" Margin="0,0,8,8">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" FontSize="11" Text="Ridge height"/><TextBlock x:Name="valRidgeH" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Padding="10,4" Margin="0,0,0,8"
                                    ToolTip="Cladding zone width a (Fig. 30.3-1 and 30.3-2): sets where the edge and corner zones are. It does not set the area GCp is read at.">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" FontSize="11" Text="Zone width a"/><TextBlock x:Name="valA" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Padding="10,4" Margin="0,0,8,0"
                                    ToolTip="Plan ratio for wind from the west, L/B (Fig. 27.3-1 leeward wall Cp). For wind from the south it is B/L.">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" FontSize="11" Text="L/B (B/L)"/><TextBlock x:Name="valLB" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Padding="10,4" Margin="0,0,8,0"
                                    ToolTip="h/L: roof Cp for wind from the west (Fig. 27.3-1), L along the wind.">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" FontSize="11" Text="h/L (wind from W)"/><TextBlock x:Name="valHL" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Padding="10,4" Margin="0"
                                    ToolTip="h/B: roof Cp for wind from the south (Fig. 27.3-1), B along the wind.">
                                <StackPanel><TextBlock Style="{StaticResource StatLabel}" FontSize="11" Text="h/B (wind from S)"/><TextBlock x:Name="valHB" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock x:Name="msgBuilding" Style="{StaticResource FieldMessage}"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Section}" Padding="0" ClipToBounds="True">
                        <ContentControl x:Name="ccViewerBuilding"/>
                    </Border>
                    <!-- Live results while the building is edited (same numbers as the Results page) -->
                    <UniformGrid x:Name="ugLiveResults" Grid.Row="1" Columns="4" Margin="0,10,0,0">
                        <Border Style="{StaticResource StatCard}" Padding="12,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Roof uplift · cladding"/>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="liveRoof" Style="{StaticResource StatValue}" FontSize="18" Foreground="#9B1C1C"/><TextBlock x:Name="liveRoofUnit" Style="{StaticResource StatUnit}" Margin="4,0,0,2" Text="psf"/></StackPanel>
                                <TextBlock x:Name="liveRoofSub" Style="{StaticResource StatDetail}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Padding="12,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Wall suction · cladding"/>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="liveWall" Style="{StaticResource StatValue}" FontSize="18" Foreground="#9B1C1C"/><TextBlock x:Name="liveWallUnit" Style="{StaticResource StatUnit}" Margin="4,0,0,2" Text="psf"/></StackPanel>
                                <TextBlock x:Name="liveWallSub" Style="{StaticResource StatDetail}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Padding="12,6">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Wall force · wind from W"/>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="liveWest" Style="{StaticResource StatValue}" FontSize="18"/><TextBlock x:Name="liveWestUnit" Style="{StaticResource StatUnit}" Margin="4,0,0,2" Text="kips"/></StackPanel>
                                <TextBlock x:Name="liveWestSub" Style="{StaticResource StatDetail}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Padding="12,6" Margin="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="Wall force · wind from S"/>
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="liveSouth" Style="{StaticResource StatValue}" FontSize="18"/><TextBlock x:Name="liveSouthUnit" Style="{StaticResource StatUnit}" Margin="4,0,0,2" Text="kips"/></StackPanel>
                                <TextBlock x:Name="liveSouthSub" Style="{StaticResource StatDetail}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Grid>

            <!-- ========== STEP 3: RESULTS — the prototype layout ========== -->
            <Grid x:Name="pnlResults" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbResultsSub" Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,10"/>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Roof uplift · cladding"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="valRoof" Style="{StaticResource StatValue}" Foreground="#9B1C1C"/>
                                <TextBlock x:Name="unitRoof" Style="{StaticResource StatUnit}" Text="psf"/>
                            </StackPanel>
                            <TextBlock x:Name="subRoof" Grid.Row="2" Style="{StaticResource StatDetail}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Wall suction · cladding"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="valWall" Style="{StaticResource StatValue}" Foreground="#9B1C1C"/>
                                <TextBlock x:Name="unitWall" Style="{StaticResource StatUnit}" Text="psf"/>
                            </StackPanel>
                            <TextBlock x:Name="subWall" Grid.Row="2" Style="{StaticResource StatDetail}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Shear-wall force · wind from W"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="valWest" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="unitWest" Style="{StaticResource StatUnit}" Text="kips"/>
                            </StackPanel>
                            <TextBlock x:Name="subWest" Grid.Row="2" Style="{StaticResource StatDetail}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource StatLabel}" Text="Shear-wall force · wind from S"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="valSouth" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="unitSouth" Style="{StaticResource StatUnit}" Text="kips"/>
                            </StackPanel>
                            <TextBlock x:Name="subSouth" Grid.Row="2" Style="{StaticResource StatDetail}"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Section}" Padding="0" ClipToBounds="True">
                        <ContentControl x:Name="ccViewerResults"/>
                    </Border>
                    <ScrollViewer x:Name="svResultsSide" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource Section}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Checks"/>
                                    <ItemsControl x:Name="icChecks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Left" Width="20" FontWeight="Bold" Text="{Binding Mark}" Foreground="{Binding MarkBrush}"/>
                                                    <TextBlock TextWrapping="Wrap" FontSize="13"><Run FontWeight="SemiBold" Text="{Binding Lead, Mode=OneWay}"/> <Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <!-- title, then the MWFRS procedure for the shear-wall loads on the same row -->
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                    ToolTip="Chapter 27 (directional) works for any building. Chapter 28 Part 1 (envelope) is for low-rise buildings (h ≤ 60 ft and h ≤ least plan dimension) with flat or gable roofs, and often gives lower forces.">
                                            <RadioButton x:Name="rbProc27" GroupName="proc" Style="{StaticResource Chip}" Content="Ch. 27" IsChecked="True" Checked="Input_Changed"
                                                         AutomationProperties.Name="Chapter 27 directional procedure"/>
                                            <RadioButton x:Name="rbProc28" GroupName="proc" Style="{StaticResource Chip}" Margin="0" Content="Ch. 28 low-rise" Checked="Input_Changed"
                                                         AutomationProperties.Name="Chapter 28 envelope procedure"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="Shear walls"/>
                                    </DockPanel>
                                    <!-- Whether the shear walls use these loads: green = yes (automatic), amber = no -->
                                    <Border x:Name="bdLinked" Margin="0,0,0,10" Padding="10,8" CornerRadius="6" Background="#EAF4EA" BorderBrush="#7FB77F" BorderThickness="1" Visibility="Collapsed">
                                        <DockPanel>
                                            <TextBlock x:Name="tbLinkedMark" DockPanel.Dock="Left" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" Foreground="#006300" Text="✓"/>
                                            <StackPanel>
                                                <TextBlock x:Name="tbLinkedTitle" FontWeight="SemiBold" Foreground="#004D00" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="tbLinked" TextWrapping="Wrap" FontSize="12" Foreground="#004D00"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <CheckBox x:Name="cbOnlyCases13" VerticalContentAlignment="Top" Checked="Input_Changed" Unchecked="Input_Changed">
                                        <StackPanel>
                                            <TextBlock x:Name="tbOnlyCasesTitle" FontWeight="SemiBold" Text="Use load cases 1 and 3 only"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Allowed for 1 story with h ≤ 30 ft, or up to 2 stories light-frame or with flexible diaphragms."/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock x:Name="tbCaseCount" Style="{StaticResource Hint}" Margin="0,8,0,4"/>
                                    <!-- Fig. 27.3-8 load cases in plain words; cases 2 and 4 fade when only 1 and 3 are used -->
                                    <Grid x:Name="gridCases" TextElement.FontSize="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="Case 1"/>
                                        <TextBlock x:Name="tbCase1b" Grid.Column="1" TextWrapping="Wrap" Text="Full wind, each direction alone"/>
                                        <TextBlock x:Name="tbCase2a" Grid.Row="1" FontWeight="SemiBold" Text="Case 2"/>
                                        <TextBlock x:Name="tbCase2b" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="75%, 15% off-center (twists the building)"/>
                                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Case 3"/>
                                        <TextBlock x:Name="tbCase3b" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="75% from both directions at once"/>
                                        <TextBlock x:Name="tbCase4a" Grid.Row="3" FontWeight="SemiBold" Text="Case 4"/>
                                        <TextBlock x:Name="tbCase4b" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Text="56% from both at once, 15% off-center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Footer navigation ===== -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Button x:Name="btnBack" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Back" Click="Back_Click"/>
                <TextBlock x:Name="tbStepOf" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock x:Name="tbSendStatus" VerticalAlignment="Center" Margin="0,0,14,0" Style="{StaticResource Hint}" MaxWidth="420"/>
                    <Button x:Name="btnNext" Style="{StaticResource PrimaryButton}" Content="Next: Building" Click="Next_Click"/>
                    <Button x:Name="btnDetails" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Content="Detailed calculations" Click="Details_Click" Visibility="Collapsed"
                            ToolTip="Every coefficient, pressure and graph behind these results (cladding and both wind directions)"/>
                    <Button x:Name="btnSend" Style="{StaticResource PrimaryButton}" Content="Use these wind loads for the shear walls" Click="Send_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnShearWalls" Style="{StaticResource PrimaryButton}" Content="Next: Shear walls" Click="ShearWalls_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
