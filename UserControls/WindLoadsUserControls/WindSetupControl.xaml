<UserControl x:Class="ASCE7WindLoadCalculator.WindSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ASCE7WindLoadCalculator"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1360"
             Background="#F9F9F7" FontFamily="Segoe UI" FontSize="14" Foreground="#0B0B0B">

    <UserControl.Resources>
        <SolidColorBrush x:Key="InkPrimary" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="InkSecondary" Color="#52514E"/>
        <SolidColorBrush x:Key="Hairline" Color="#E1E0D9"/>
        <SolidColorBrush x:Key="Control" Color="#C3C2B7"/>
        <SolidColorBrush x:Key="Surface" Color="#FCFCFB"/>
        <SolidColorBrush x:Key="Selected" Color="#F0EFEC"/>
        <SolidColorBrush x:Key="WarnInk" Color="#8A3B00"/>
        <SolidColorBrush x:Key="WarnBorder" Color="#B45309"/>
        <SolidColorBrush x:Key="OkInk" Color="#006300"/>

        <!-- A group of related inputs -->
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14,18,16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldMessage" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{StaticResource WarnInk}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Large selectable card (radio button): a title line plus a description -->
        <Style x:Key="Card" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Control}"
                                Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0B0B0B"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="#F0EFEC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2A78D6"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact choice (radio button) -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Control}"
                                Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0B0B0B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0B0B0B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2A78D6"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Number box: the TextBox sits inside a Border that also shows the unit -->
        <Style x:Key="NumberFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Footer buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="#0B0B0B" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33332F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#898781"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="White" BorderBrush="{StaticResource Control}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Step indicator button -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header with the step indicator ===== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="28,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Wind setup" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Three steps. Results update as you type." Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel x:Name="spSteps" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ===== Step content ===== -->
        <ScrollViewer Grid.Row="1" x:Name="svContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="gridContent" Margin="28,20,28,12" MaxWidth="1400">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition x:Name="colRight" Width="7*"/>
                </Grid.ColumnDefinitions>

                <!-- ========== STEP 1: SITE ========== -->
                <Grid x:Name="pnlSite" Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
                        <TextBlock Text="Where is the building?" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="14" Text="These choices set how strong the wind is at your site."/>
                    </StackPanel>

                    <StackPanel x:Name="siteLeft" Grid.Row="1" Grid.Column="0">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Building code edition"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbEd22" GroupName="ed" Style="{StaticResource Chip}" Content="ASCE 7-22" Checked="Input_Changed"/>
                                    <RadioButton x:Name="rbEd16" GroupName="ed" Style="{StaticResource Chip}" Content="ASCE 7-16" Checked="Input_Changed"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Use the edition your building department enforces."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}">How important is the building? <Run Foreground="#52514E" FontWeight="Normal">(Risk Category)</Run></TextBlock>
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="rbRisk1" GroupName="risk" Style="{StaticResource Card}" Margin="0,0,8,8" Checked="Input_Changed">
                                        <StackPanel><TextBlock FontWeight="SemiBold" Text="Risk Category I"/><TextBlock Style="{StaticResource Hint}" Text="Low hazard to people: barns, sheds, minor storage"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbRisk2" GroupName="risk" Style="{StaticResource Card}" Margin="0,0,0,8" Checked="Input_Changed">
                                        <StackPanel><TextBlock FontWeight="SemiBold" Text="Risk Category II"/><TextBlock Style="{StaticResource Hint}" Text="Most buildings: homes, offices, shops"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbRisk3" GroupName="risk" Style="{StaticResource Card}" Margin="0,0,8,8" Checked="Input_Changed">
                                        <StackPanel><TextBlock FontWeight="SemiBold" Text="Risk Category III"/><TextBlock Style="{StaticResource Hint}" Text="Many people at once: schools, large venues"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbRisk4" GroupName="risk" Style="{StaticResource Card}" Margin="0,0,0,8" Checked="Input_Changed">
                                        <StackPanel><TextBlock FontWeight="SemiBold" Text="Risk Category IV"/><TextBlock Style="{StaticResource Hint}" Text="Essential: hospitals, fire and police stations"/></StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Hint}" Text="This picks which ASCE 7 wind-speed map to read. It does not multiply the loads."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Basic wind speed"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Wind speed V"/>
                                        <Border x:Name="bdV" Style="{StaticResource NumberFrame}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="mph"/>
                                                <TextBox x:Name="tbV" Style="{StaticResource NumberBox}" FontSize="18" TextChanged="Input_Changed"
                                                         AutomationProperties.Name="Wind speed V in mph"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Where do I find this?"/>
                                        <TextBlock TextWrapping="Wrap">Read V for <Run x:Name="runRisk" FontWeight="SemiBold" Text="Risk Category II"/> at your address on the
                                            <Hyperlink NavigateUri="https://ascehazardtool.org" RequestNavigate="Hyperlink_RequestNavigate">ASCE Hazard Tool</Hyperlink> (free web lookup).</TextBlock>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="msgV" Style="{StaticResource FieldMessage}"/>
                                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="6" BorderBrush="{StaticResource Control}" BorderThickness="1">
                                    <TextBlock Style="{StaticResource Hint}" Text="Coming later: type the site address and the app fills in V automatically (needs an ASCE Hazard Tool account)."/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="siteRight" Grid.Row="1" Grid.Column="2">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}">What is the ground like upwind of the site? <Run Foreground="#52514E" FontWeight="Normal">(Exposure)</Run></TextBlock>
                                <RadioButton x:Name="rbExpB" GroupName="exp" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <DockPanel>
                                        <Canvas DockPanel.Dock="Left" Width="84" Height="40" Margin="0,0,14,0">
                                            <Path Stroke="#898781" StrokeThickness="1.5" Data="M2,38 H82"/>
                                            <Path Stroke="#52514E" StrokeThickness="1.5" Data="M6,18 h12 v20 h-12 z M22,10 h10 v28 h-10 z M38,38 V24 l7,-6 7,6 v14 M70,38 V22 l6,-5 6,5 v16"/>
                                            <Ellipse Canvas.Left="55" Canvas.Top="17" Width="14" Height="14" Stroke="#52514E" StrokeThickness="1.5"/>
                                            <Path Stroke="#52514E" StrokeThickness="1.5" Data="M62,31 V38"/>
                                        </Canvas>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="B: Suburbs, towns, wooded areas"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Houses or trees close together for at least 2,600 ft upwind (1,500 ft if the mean roof height is 30 ft or less), or 20 × the building height if that is more."/>
                                        </StackPanel>
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbExpC" GroupName="exp" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <DockPanel>
                                        <Canvas DockPanel.Dock="Left" Width="84" Height="40" Margin="0,0,14,0">
                                            <Path Stroke="#898781" StrokeThickness="1.5" Data="M2,38 H82"/>
                                            <Path Stroke="#52514E" StrokeThickness="1.5" Data="M12,38 V28 l6,-5 6,5 v10 M52,34 v4"/>
                                            <Ellipse Canvas.Left="47" Canvas.Top="24" Width="10" Height="10" Stroke="#52514E" StrokeThickness="1.5"/>
                                        </Canvas>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="C: Open country, farmland, scattered buildings"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Anywhere B or D does not apply. The usual choice when in doubt."/>
                                        </StackPanel>
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbExpD" GroupName="exp" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <DockPanel>
                                        <Canvas DockPanel.Dock="Left" Width="84" Height="40" Margin="0,0,14,0">
                                            <Path Stroke="#52514E" StrokeThickness="1.5" Data="M2,30 c8,-4 14,4 22,0 s14,-4 22,0 14,4 22,0 10,-3 14,-1"/>
                                            <Path Stroke="#898781" StrokeThickness="1.5" Data="M2,38 H82"/>
                                        </Canvas>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="D: Shorelines, open water, flat unobstructed land"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Only if water or flat open land runs at least 5,000 ft upwind, or 20 × the building height if that is more. Also applies within 600 ft (or 20 × height) downwind of it."/>
                                        </StackPanel>
                                    </DockPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Is the site on a hill, ridge or bluff?"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbHillNo" GroupName="hill" Style="{StaticResource Chip}" Content="No, fairly flat" Checked="Input_Changed"/>
                                    <RadioButton x:Name="rbHillYes" GroupName="hill" Style="{StaticResource Chip}" Content="Yes" Checked="Input_Changed"/>
                                </StackPanel>
                                <Grid x:Name="pnlKzt" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Topographic factor Kzt"/>
                                        <Border x:Name="bdKzt" Style="{StaticResource NumberFrame}">
                                            <TextBox x:Name="tbKzt" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Topographic factor Kzt"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource Hint}"
                                               Text="From ASCE 7 Section 26.8. Wind speeds up over hills, so Kzt is 1.0 or more."/>
                                </Grid>
                                <TextBlock x:Name="msgKzt" Style="{StaticResource FieldMessage}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}">How open is the building? <Run Foreground="#52514E" FontWeight="Normal">(Enclosure)</Run></TextBlock>
                                <RadioButton x:Name="rbEncEnclosed" GroupName="enc" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Enclosed"/><TextBlock Style="{StaticResource Hint}" Text="Normal walls with doors and windows (most buildings)"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbEncPartEnc" GroupName="enc" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Partially enclosed"/><TextBlock Style="{StaticResource Hint}" Text="One wall has much more opening than the others, e.g. a large door often left open"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbEncPartOpen" GroupName="enc" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Partially open"/><TextBlock Style="{StaticResource Hint}" Text="Neither enclosed, partially enclosed nor open"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbEncOpen" GroupName="enc" Style="{StaticResource Card}" Margin="0" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Open"/><TextBlock Style="{StaticResource Hint}" Text="Every wall at least 80% open, e.g. a carport or pavilion"/></StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ========== STEP 2: BUILDING (left column) ========== -->
                <StackPanel x:Name="pnlBuilding" Grid.Column="0" Margin="0,0,20,0" Visibility="Collapsed">
                    <TextBlock Text="Describe the building" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,16" Text="The 3D view updates as you type. Measure the plan to the outside of the walls."/>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Roof shape"/>
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="rbRoofFlat" GroupName="roof" Style="{StaticResource Card}" Margin="0,0,8,0" Checked="Input_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Canvas Width="64" Height="40"><Path Stroke="#0B0B0B" StrokeThickness="1.8" Data="M8,16 h48 v20 h-48 z"/><Path Stroke="#0B0B0B" StrokeThickness="3" Data="M6,16 h52"/></Canvas>
                                        <TextBlock Text="Flat" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbRoofGable" GroupName="roof" Style="{StaticResource Card}" Margin="0,0,8,0" Checked="Input_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Canvas Width="64" Height="40"><Path Stroke="#0B0B0B" StrokeThickness="1.8" Data="M10,20 h44 v16 h-44 z M6,22 L32,5 58,22" StrokeLineJoin="Round"/></Canvas>
                                        <TextBlock Text="Gable" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbRoofHip" GroupName="roof" Style="{StaticResource Card}" Margin="0" Checked="Input_Changed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Canvas Width="64" Height="40"><Path Stroke="#0B0B0B" StrokeThickness="1.8" Data="M10,20 h44 v16 h-44 z M6,22 L20,8 44,8 58,22" StrokeLineJoin="Round"/></Canvas>
                                        <TextBlock Text="Hip" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Size"/>
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Length L (west to east)"/>
                                    <Border x:Name="bdL" Style="{StaticResource NumberFrame}">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                            <TextBox x:Name="tbL" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Length L in feet"/></DockPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Width B (south to north)"/>
                                    <Border x:Name="bdB" Style="{StaticResource NumberFrame}">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                            <TextBox x:Name="tbB" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Width B in feet"/></DockPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Wall height to eave"/>
                                    <Border x:Name="bdH" Style="{StaticResource NumberFrame}">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                            <TextBox x:Name="tbH" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Wall height to eave in feet"/></DockPanel>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="msgSize" Style="{StaticResource FieldMessage}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="secSlope" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Roof slope"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Width="140">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pitch"/>
                                    <Border x:Name="bdPitch" Style="{StaticResource NumberFrame}">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="deg"/>
                                            <TextBox x:Name="tbPitch" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Roof pitch in degrees"/></DockPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock VerticalAlignment="Bottom" Margin="16,0,0,11" Foreground="{StaticResource InkSecondary}">
                                    = <Run x:Name="runRise" FontWeight="SemiBold" Foreground="#0B0B0B" Text="-"/> (rise per 12 in. of run)</TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="pnlRidge" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="The ridge runs"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbRidgeAlong" GroupName="ridge" Style="{StaticResource Chip}" Content="Along the length (west to east)" Checked="Input_Changed"/>
                                    <RadioButton x:Name="rbRidgeAcross" GroupName="ridge" Style="{StaticResource Chip}" Content="Across the width (south to north)" Checked="Input_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="tbHipNote" Style="{StaticResource Hint}" Margin="0,10,0,0" Text="A hip roof's ridge runs along the longer side."/>
                            <TextBlock x:Name="msgPitch" Style="{StaticResource FieldMessage}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== STEP 3: RESULTS (left column) ========== -->
                <StackPanel x:Name="pnlResults" Grid.Column="0" Margin="0,0,20,0" Visibility="Collapsed">
                    <TextBlock Text="Wind results" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="tbResultsSub" Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,16"/>

                    <UniformGrid Columns="2" Margin="0,0,-12,0">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Highest roof uplift (cladding)"/>
                                <TextBlock x:Name="valRoof" Style="{StaticResource StatValue}" Foreground="#9B1C1C"/>
                                <TextBlock x:Name="subRoof" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Highest wall suction (cladding)"/>
                                <TextBlock x:Name="valWall" Style="{StaticResource StatValue}" Foreground="#9B1C1C"/>
                                <TextBlock x:Name="subWall" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Wind force on the building, from the west"/>
                                <TextBlock x:Name="valWest" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="subWest" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Wind force on the building, from the south"/>
                                <TextBlock x:Name="valSouth" Style="{StaticResource StatValue}"/>
                                <TextBlock x:Name="subSouth" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Section}" Margin="0,4,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Checks"/>
                            <ItemsControl x:Name="icChecks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Left" Width="22" FontWeight="Bold" Text="{Binding Mark}" Foreground="{Binding MarkBrush}"/>
                                            <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="{Binding Lead, Mode=OneWay}"/> <Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Shear walls"/>
                            <CheckBox x:Name="cbOnlyCases13" VerticalContentAlignment="Top" Checked="Input_Changed" Unchecked="Input_Changed">
                                <TextBlock TextWrapping="Wrap" Text="One story with mean roof height 30 ft or less, or two stories or less with light-frame construction or flexible diaphragms (ASCE 7 Fig. 27.3-8: use load cases 1 and 3 only)"/>
                            </CheckBox>
                            <TextBlock x:Name="tbCaseCount" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== Right column on steps 2 and 3: the live 3D view ========== -->
                <StackPanel x:Name="pnlRight" Grid.Column="1" Visibility="Collapsed">
                    <Border Style="{StaticResource Section}" Padding="0" Height="600" ClipToBounds="True">
                        <ContentControl x:Name="ccViewer"/>
                    </Border>
                    <UniformGrid x:Name="ugBuildingNumbers" Columns="3" Margin="0,0,-12,0">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel><TextBlock Style="{StaticResource Hint}" Text="Mean roof height h"/><TextBlock x:Name="valMeanH" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel><TextBlock Style="{StaticResource Hint}" Text="Ridge height"/><TextBlock x:Name="valRidgeH" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel><TextBlock Style="{StaticResource Hint}" Text="Cladding method"/><TextBlock x:Name="valCC" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="msgBuilding" Style="{StaticResource FieldMessage}" Margin="0,0,0,12"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===== Footer navigation ===== -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="28,10">
            <Grid>
                <Button x:Name="btnBack" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Back" Click="Back_Click"/>
                <TextBlock x:Name="tbStepOf" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock x:Name="tbSendStatus" VerticalAlignment="Center" Margin="0,0,14,0" Style="{StaticResource Hint}" MaxWidth="420"/>
                    <Button x:Name="btnNext" Style="{StaticResource PrimaryButton}" Content="Next: Building" Click="Next_Click"/>
                    <Button x:Name="btnSend" Style="{StaticResource PrimaryButton}" Content="Send loads to shear walls" Click="Send_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
