<UserControl x:Class="ASCE7WindLoadCalculator.WindSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ASCE7WindLoadCalculator"
             mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1360"
             Background="#F9F9F7" FontFamily="Segoe UI" FontSize="13" Foreground="#0B0B0B">

    <UserControl.Resources>
        <SolidColorBrush x:Key="InkPrimary" Color="#0B0B0B"/>
        <SolidColorBrush x:Key="InkSecondary" Color="#52514E"/>
        <SolidColorBrush x:Key="Hairline" Color="#E1E0D9"/>
        <SolidColorBrush x:Key="Control" Color="#C3C2B7"/>
        <SolidColorBrush x:Key="Surface" Color="#FCFCFB"/>
        <SolidColorBrush x:Key="Selected" Color="#F0EFEC"/>
        <SolidColorBrush x:Key="WarnInk" Color="#8A3B00"/>
        <SolidColorBrush x:Key="WarnBorder" Color="#B45309"/>
        <SolidColorBrush x:Key="OkInk" Color="#006300"/>

        <!-- A group of related inputs -->
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10,16,12"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldMessage" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{StaticResource WarnInk}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Large selectable card (radio button): a title line plus a description -->
        <Style x:Key="Card" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Control}"
                                Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0B0B0B"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="#F0EFEC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2A78D6"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact choice (radio button) -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource Control}"
                                Background="White" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0B0B0B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0B0B0B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2A78D6"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Number box: the TextBox sits inside a Border that also shows the unit -->
        <Style x:Key="NumberFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Control}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Footer buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="#0B0B0B" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33332F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#898781"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="White" BorderBrush="{StaticResource Control}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Step indicator button -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <!-- Laid out to fit the Wind Setup tab beside the drawing canvas (about 1130 x 790 at 1920 x 1080)
         without scrolling. Scroll bars appear only if the window is made smaller than that. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header with the step indicator ===== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="20,4">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="tbStepTitle" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="Where is the building?"/>
                <StackPanel x:Name="spSteps" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,12,20,12">

            <!-- ========== STEP 1: SITE ========== -->
            <ScrollViewer x:Name="pnlSite" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: edition | wind speed | hill -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Section}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Code edition"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbEd22" GroupName="ed" Style="{StaticResource Chip}" Content="ASCE 7-22" Checked="Input_Changed"/>
                                    <RadioButton x:Name="rbEd16" GroupName="ed" Style="{StaticResource Chip}" Margin="0" Content="ASCE 7-16" Checked="Input_Changed"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Use the one your building department enforces."/>
                            </StackPanel>
                        </Border>
                        <!-- Wind speed: the most important site input, so it is highlighted -->
                        <Border Grid.Column="1" Style="{StaticResource Section}" Margin="0,0,10,0" Background="#EEF4FC" BorderBrush="#2A78D6" BorderThickness="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Foreground="#104281" Text="Basic wind speed V"/>
                                    <Border x:Name="bdV" Style="{StaticResource NumberFrame}" BorderThickness="2" BorderBrush="#2A78D6" Height="42">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="mph"/>
                                            <TextBox x:Name="tbV" Style="{StaticResource NumberBox}" FontSize="20" FontWeight="SemiBold" TextChanged="Input_Changed"
                                                     AutomationProperties.Name="Wind speed V in mph"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap">Use the map for <Run x:Name="runRisk" FontWeight="SemiBold" Foreground="#104281" Text="Risk Category II"/>
                                        (it follows your choice below).</TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3,0,0">Look it up by address: <Hyperlink NavigateUri="https://ascehazardtool.org" RequestNavigate="Hyperlink_RequestNavigate">ASCE Hazard Tool</Hyperlink> (free).</TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="msgV" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FieldMessage}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Section}" MinWidth="250">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="On a hill, ridge or bluff?"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbHillNo" GroupName="hill" Style="{StaticResource Chip}" Content="No, fairly flat" Checked="Input_Changed"/>
                                    <RadioButton x:Name="rbHillYes" GroupName="hill" Style="{StaticResource Chip}" Content="Yes" Checked="Input_Changed"/>
                                    <!-- Kzt is always shown: fixed at 1.00 for flat ground, editable for a hill -->
                                    <TextBlock x:Name="tbKztFixed" VerticalAlignment="Center" Margin="4,0,0,0">Kzt = <Run FontWeight="SemiBold" Text="1.00"/></TextBlock>
                                    <StackPanel x:Name="pnlKzt" Orientation="Horizontal" Visibility="Collapsed">
                                        <Border x:Name="bdKzt" Style="{StaticResource NumberFrame}" Width="100">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Unit}" Margin="0,0,6,0" Text="Kzt ="/>
                                                <TextBox x:Name="tbKzt" Style="{StaticResource NumberBox}" MinWidth="40" TextChanged="Input_Changed" AutomationProperties.Name="Topographic factor Kzt"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="tbKztHint" Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Hills speed up the wind (Kzt, Section 26.8)."/>
                                <TextBlock x:Name="msgKzt" Style="{StaticResource FieldMessage}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: risk category -->
                    <Border Grid.Row="1" Style="{StaticResource Section}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}">How important is the building? <Run Foreground="#52514E" FontWeight="Normal">(Risk Category: picks which wind-speed map to read; it does not multiply the loads)</Run></TextBlock>
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="rbRisk1" GroupName="risk" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="I: Low hazard"/><TextBlock Style="{StaticResource Hint}" Text="Barns, sheds, minor storage"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbRisk2" GroupName="risk" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="II: Most buildings"/><TextBlock Style="{StaticResource Hint}" Text="Homes, offices, shops"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbRisk3" GroupName="risk" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="III: Many people"/><TextBlock Style="{StaticResource Hint}" Text="Schools, large venues"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbRisk4" GroupName="risk" Style="{StaticResource Card}" Margin="0" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="IV: Essential"/><TextBlock Style="{StaticResource Hint}" Text="Hospitals, fire and police stations"/></StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Row 3: exposure -->
                    <Border Grid.Row="2" Style="{StaticResource Section}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}">What is the ground like upwind of the site? <Run Foreground="#52514E" FontWeight="Normal">(Exposure)</Run></TextBlock>
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="rbExpB" GroupName="exp" Style="{StaticResource Card}" VerticalContentAlignment="Top" Checked="Input_Changed">
                                    <StackPanel>
                                        <DockPanel>
                                            <Canvas DockPanel.Dock="Left" Width="60" Height="28" Margin="0,0,10,0">
                                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Canvas.RenderTransform>
                                                <Path Stroke="#898781" StrokeThickness="1.5" Data="M2,38 H82"/>
                                                <Path Stroke="#52514E" StrokeThickness="1.5" Data="M6,18 h12 v20 h-12 z M22,10 h10 v28 h-10 z M38,38 V24 l7,-6 7,6 v14 M70,38 V22 l6,-5 6,5 v16"/>
                                                <Ellipse Canvas.Left="55" Canvas.Top="17" Width="14" Height="14" Stroke="#52514E" StrokeThickness="1.5"/>
                                                <Path Stroke="#52514E" StrokeThickness="1.5" Data="M62,31 V38"/>
                                            </Canvas>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="B: Suburbs, towns, woods"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Houses or trees close together for at least 2,600 ft upwind (1,500 ft if the mean roof height is 30 ft or less), or 20 × the building height if more."/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbExpC" GroupName="exp" Style="{StaticResource Card}" VerticalContentAlignment="Top" Checked="Input_Changed">
                                    <StackPanel>
                                        <DockPanel>
                                            <Canvas DockPanel.Dock="Left" Width="60" Height="28" Margin="0,0,10,0">
                                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Canvas.RenderTransform>
                                                <Path Stroke="#898781" StrokeThickness="1.5" Data="M2,38 H82"/>
                                                <Path Stroke="#52514E" StrokeThickness="1.5" Data="M12,38 V28 l6,-5 6,5 v10 M52,34 v4"/>
                                                <Ellipse Canvas.Left="47" Canvas.Top="24" Width="10" Height="10" Stroke="#52514E" StrokeThickness="1.5"/>
                                            </Canvas>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="C: Open country, farmland"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Scattered buildings or trees. Anywhere B or D does not apply; the usual choice when in doubt."/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbExpD" GroupName="exp" Style="{StaticResource Card}" Margin="0" VerticalContentAlignment="Top" Checked="Input_Changed">
                                    <StackPanel>
                                        <DockPanel>
                                            <Canvas DockPanel.Dock="Left" Width="60" Height="28" Margin="0,0,10,0">
                                                <Canvas.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Canvas.RenderTransform>
                                                <Path Stroke="#52514E" StrokeThickness="1.5" Data="M2,30 c8,-4 14,4 22,0 s14,-4 22,0 14,4 22,0 10,-3 14,-1"/>
                                                <Path Stroke="#898781" StrokeThickness="1.5" Data="M2,38 H82"/>
                                            </Canvas>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Text="D: Shoreline, open water"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Only if water or flat open land runs at least 5,000 ft upwind, or 20 × the building height if more. Also within 600 ft (or 20 × height) downwind of it."/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Row 4: enclosure -->
                    <Border Grid.Row="3" Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}">How open is the building? <Run Foreground="#52514E" FontWeight="Normal">(Enclosure)</Run></TextBlock>
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="rbEncEnclosed" GroupName="enc" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Enclosed"/><TextBlock Style="{StaticResource Hint}" Text="Normal walls, doors and windows (most buildings)"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbEncPartEnc" GroupName="enc" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Partially enclosed"/><TextBlock Style="{StaticResource Hint}" Text="One wall much more open, e.g. a large door often left open"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbEncPartOpen" GroupName="enc" Style="{StaticResource Card}" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Partially open"/><TextBlock Style="{StaticResource Hint}" Text="None of the other three"/></StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbEncOpen" GroupName="enc" Style="{StaticResource Card}" Margin="0" Checked="Input_Changed">
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="Open"/><TextBlock Style="{StaticResource Hint}" Text="Every wall at least 80% open, e.g. a carport"/></StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ========== STEP 2: BUILDING — inputs left, 3D view right ========== -->
            <Grid x:Name="pnlBuilding" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="svBuildingInputs" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Section}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Roof shape"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="rbRoofFlat" GroupName="roof" Style="{StaticResource Chip}" Checked="Input_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="30" Height="18" Margin="0,0,8,0"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Data="M3,7 h24 v10 h-24 z M2,7 h26"/></Canvas>
                                            <TextBlock Text="Flat" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbRoofGable" GroupName="roof" Style="{StaticResource Chip}" Checked="Input_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="30" Height="18" Margin="0,0,8,0"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M4,9 h22 v8 h-22 z M2,10 L15,1 28,10"/></Canvas>
                                            <TextBlock Text="Gable" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbRoofHip" GroupName="roof" Style="{StaticResource Chip}" Margin="0" Checked="Input_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <Canvas Width="30" Height="18" Margin="0,0,8,0"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M4,9 h22 v8 h-22 z M2,10 L9,2 21,2 28,10"/></Canvas>
                                            <TextBlock Text="Hip" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Size (to the outside of the walls)"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Length L (W-E)"/>
                                        <Border x:Name="bdL" Style="{StaticResource NumberFrame}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                                <TextBox x:Name="tbL" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Length L in feet"/></DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Width B (S-N)"/>
                                        <Border x:Name="bdB" Style="{StaticResource NumberFrame}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                                <TextBox x:Name="tbB" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Width B in feet"/></DockPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Eave height"/>
                                        <Border x:Name="bdH" Style="{StaticResource NumberFrame}">
                                            <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ft"/>
                                                <TextBox x:Name="tbH" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" AutomationProperties.Name="Wall height to eave in feet"/></DockPanel>
                                        </Border>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="msgSize" Style="{StaticResource FieldMessage}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="secSlope" Style="{StaticResource Section}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Roof slope"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="bdPitch" Style="{StaticResource NumberFrame}" Width="120">
                                        <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="deg"/>
                                            <TextBox x:Name="tbPitch" Style="{StaticResource NumberBox}" TextChanged="Input_Changed" LostFocus="Pitch_LostFocus" AutomationProperties.Name="Roof pitch in degrees"/></DockPanel>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource InkSecondary}">
                                        = <Run x:Name="runRise" FontWeight="SemiBold" Foreground="#0B0B0B" Text="-"/> (rise per 12 in. of run)</TextBlock>
                                </StackPanel>
                                <StackPanel x:Name="pnlRidge" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="The ridge runs"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="rbRidgeAlong" GroupName="ridge" Style="{StaticResource Chip}" Content="Along the length (W-E)" Checked="Input_Changed"/>
                                        <RadioButton x:Name="rbRidgeAcross" GroupName="ridge" Style="{StaticResource Chip}" Margin="0" Content="Across the width (S-N)" Checked="Input_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="tbHipNote" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="A hip roof's ridge runs along the longer side."/>
                                <TextBlock x:Name="msgPitch" Style="{StaticResource FieldMessage}"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid x:Name="ugBuildingNumbers" Columns="3">
                            <Border Style="{StaticResource StatCard}" Padding="12,8">
                                <StackPanel><TextBlock Style="{StaticResource Hint}" Text="Mean roof height h"/><TextBlock x:Name="valMeanH" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Padding="12,8">
                                <StackPanel><TextBlock Style="{StaticResource Hint}" Text="Ridge height"/><TextBlock x:Name="valRidgeH" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatCard}" Padding="12,8" Margin="0">
                                <StackPanel><TextBlock Style="{StaticResource Hint}" Text="Cladding method"/><TextBlock x:Name="valCC" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock x:Name="msgBuilding" Style="{StaticResource FieldMessage}"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Style="{StaticResource Section}" Padding="0" ClipToBounds="True">
                    <ContentControl x:Name="ccViewerBuilding"/>
                </Border>
            </Grid>

            <!-- ========== STEP 3: RESULTS — the prototype layout ========== -->
            <Grid x:Name="pnlResults" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="tbResultsSub" Style="{StaticResource Hint}" FontSize="14" Margin="0,0,0,10"/>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Highest roof uplift"/>
                            <TextBlock x:Name="valRoof" Style="{StaticResource StatValue}" Foreground="#9B1C1C"/>
                            <TextBlock x:Name="subRoof" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Highest wall suction"/>
                            <TextBlock x:Name="valWall" Style="{StaticResource StatValue}" Foreground="#9B1C1C"/>
                            <TextBlock x:Name="subWall" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Wind force, from the west"/>
                            <TextBlock x:Name="valWest" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="subWest" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Wind force, from the south"/>
                            <TextBlock x:Name="valSouth" Style="{StaticResource StatValue}"/>
                            <TextBlock x:Name="subSouth" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Section}" Padding="0" ClipToBounds="True">
                        <ContentControl x:Name="ccViewerResults"/>
                    </Border>
                    <ScrollViewer x:Name="svResultsSide" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource Section}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Checks"/>
                                    <ItemsControl x:Name="icChecks">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Left" Width="20" FontWeight="Bold" Text="{Binding Mark}" Foreground="{Binding MarkBrush}"/>
                                                    <TextBlock TextWrapping="Wrap" FontSize="13"><Run FontWeight="SemiBold" Text="{Binding Lead, Mode=OneWay}"/> <Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Shear walls"/>
                                    <!-- Whether the shear walls use these loads: green = yes (automatic), amber = no -->
                                    <Border x:Name="bdLinked" Margin="0,0,0,10" Padding="10,8" CornerRadius="6" Background="#EAF4EA" BorderBrush="#7FB77F" BorderThickness="1" Visibility="Collapsed">
                                        <DockPanel>
                                            <TextBlock x:Name="tbLinkedMark" DockPanel.Dock="Left" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" Foreground="#006300" Text="✓"/>
                                            <StackPanel>
                                                <TextBlock x:Name="tbLinkedTitle" FontWeight="SemiBold" Foreground="#004D00" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="tbLinked" TextWrapping="Wrap" FontSize="12" Foreground="#004D00"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <CheckBox x:Name="cbOnlyCases13" VerticalContentAlignment="Top" Checked="Input_Changed" Unchecked="Input_Changed">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="Use load cases 1 and 3 only"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Allowed for one story with h ≤ 30 ft, or two stories or less that are light-frame or have flexible diaphragms (Fig. 27.3-8)."/>
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock x:Name="tbCaseCount" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Footer navigation ===== -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Button x:Name="btnBack" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Back" Click="Back_Click"/>
                <TextBlock x:Name="tbStepOf" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock x:Name="tbSendStatus" VerticalAlignment="Center" Margin="0,0,14,0" Style="{StaticResource Hint}" MaxWidth="420"/>
                    <Button x:Name="btnNext" Style="{StaticResource PrimaryButton}" Content="Next: Building" Click="Next_Click"/>
                    <Button x:Name="btnSend" Style="{StaticResource PrimaryButton}" Content="Use these wind loads for the shear walls" Click="Send_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
